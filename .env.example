LINEAR_API_KEY=
GRANOLA_API_KEY=
GRANOLA_API_URL=https://public-api.granola.ai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_4_1_MODELS_ENDPOINT=https://alerts-sweden-central.openai.azure.com/
AZURE_OPENAI_4_1_MODELS_VERSION=2025-03-01-preview
AZURE_OPENAI_4_1_MODELS_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_TIMEOUT_SECONDS=600
SOP_DOC_PATH=docs/how-we-use-linear.md
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
AUDIT_MODE=manual-preview
AUDIT_OUT_DIR=results
AUDIT_STATE_PATH=state/history.json

# Local Granola+Linear MCP work-memory pilot.
# Uses Codex CLI MCP OAuth connections, not API keys.
WORK_MEMORY_LOOKBACK=last_7_days
WORK_MEMORY_MEETING_LIMIT=20
WORK_MEMORY_OUT_DIR=results/work-memory
# Optional: leave empty to use the Codex CLI default model.
WORK_MEMORY_CODEX_MODEL=
# Defaults to OpenAI because local Azure Codex provider config can be workspace-specific.
WORK_MEMORY_CODEX_PROVIDER=openai
WORK_MEMORY_TIMEOUT_SECONDS=900

# Scheduled/API work-memory runner. This is the GitHub Actions path and does
# not use Codex CLI or MCP.
WORK_MEMORY_DAYS=7
GRANOLA_PAGE_SIZE=30
GRANOLA_MAX_PAGES=10
WORK_MEMORY_INCLUDE_TRANSCRIPT=false
# Optional: restrict API runs to a Granola folder.
GRANOLA_FOLDER_ID=
# Optional: restrict API runs to multiple Granola folders.
GRANOLA_FOLDER_IDS=
# Optional metadata-only relevance gates before note detail fetch.
GRANOLA_TITLE_INCLUDE_REGEX=
GRANOLA_TITLE_EXCLUDE_REGEX=
GRANOLA_ATTENDEE_EMAIL_DOMAIN=
GRANOLA_OWNER_EMAIL=

# Daily-Standup specific workflow.
STANDUP_COVERAGE_DAYS=60
STANDUP_COVERAGE_TIMEZONE=Asia/Kolkata
STANDUP_TITLE_REGEX=^Daily[- ]Stand[- ]?up$|^Daily-Standup$
STANDUP_COVERAGE_OUT_DIR=results/standup-coverage
DAILY_STANDUP_DATE=today
DAILY_STANDUP_TIMEZONE=Asia/Kolkata
DAILY_STANDUP_TITLE_REGEX=^Daily[- ]Stand[- ]?up$|^Daily-Standup$
DAILY_STANDUP_MAX_WAIT_SECONDS=14400
DAILY_STANDUP_POLL_SECONDS=60
DAILY_STANDUP_STABLE_SECONDS=900
DAILY_STANDUP_MIN_TRANSCRIPT_CHARS=1000
DAILY_STANDUP_OUT_DIR=results/daily-standup-memory
DAILY_STANDUP_SEND_SLACK_DMS=false
DAILY_STANDUP_MAX_TRANSCRIPT_CHARS=60000
